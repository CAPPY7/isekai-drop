*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---- Isekai Drop project rules ----
# Secrets and local config (never commit)
.env
.env.*
*.env
local.properties
key.properties
**/key.properties
*.p12
*.pem
*.key
*.mobileprovision
*.keystore
# Real release keystores are never committed. Only the throwaway DEV key is allowed:
*.jks
!android/app/isekai-drop-dev.jks
credentials*
secrets*
.netrc
# Downloaded build files
releases/
*.apk
*.aab
*.ipa
# Scratch files left over from the capability check
test.txt
